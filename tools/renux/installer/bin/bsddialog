#
# bsddialog, in the installer's language.  The installer puts this first
# in PATH; bsdinstall's scripts call it as they call bsddialog.  Every
# argument the language's catalog (RENUX_LANG_FILE) knows is replaced by
# its translation, and the buttons get translated labels (and every
# dialog Renux's colors, renux.theme), but for what
# the scripts read back: the tags of menu, checklist and radiolist items,
# the values of form fields and --default-item stay as they are.

REAL=/usr/bin/bsddialog
# Renux's colors, in every language.
THEME=/usr/libexec/renux-installer/renux.theme

if [ ! -r "$RENUX_LANG_FILE" ]; then
	[ -r "$THEME" ] && exec "$REAL" --load-theme "$THEME" "$@"
	exec "$REAL" "$@"
fi
. "$RENUX_LANG_FILE"

# One argument, quoted for eval.
quote()
{
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# The layout of the dialog's items: their length, and which of their
# fields are text to translate (the others are read back by the scripts).
itemhelp=0
type=
for a in "$@"; do
	case "$a" in
	--item-help)	itemhelp=1 ;;
	--menu|--checklist|--radiolist|--treeview|--form|--passwordform|--mixedform)
		type=$a ;;
	esac
done
case "$type" in
--menu)			step=$((2 + itemhelp)); text_fields=" 1 2 " ;;
--checklist|--radiolist) step=$((3 + itemhelp)); text_fields=" 1 3 " ;;
--treeview)		step=$((4 + itemhelp)); text_fields=" 2 4 " ;;
--form|--passwordform)	step=8; text_fields=" 0 " ;;
--mixedform)		step=9; text_fields=" 0 " ;;
*)			step=0; text_fields= ;;
esac

args=
seen=0		# arguments since the dialog's type
keep_next=0	# the value of --default-item
for a in "$@"; do
	translate=1
	if [ $keep_next -eq 1 ]; then
		translate=0
		keep_next=0
	elif [ "$a" = "--default-item" ]; then
		keep_next=1
	elif [ -n "$type" ] && [ "$a" = "$type" ] && [ $seen -eq 0 ]; then
		seen=1
		args="$args $(quote "$a")"
		continue
	fi
	if [ $seen -eq 1 ]; then
		case "$a" in
		--*)
			# An option after the type (--insecure): not the text.
			args="$args $(quote "$a")"
			continue
			;;
		esac
	fi
	if [ $seen -ge 1 ]; then
		# text rows cols list-rows, then the items.
		if [ $seen -ge 5 ] && [ $step -gt 0 ]; then
			field=$(( (seen - 5) % step ))
			case "$text_fields" in
			*" $field "*)	;;
			*)		translate=0 ;;
			esac
		fi
		seen=$((seen + 1))
	fi
	if [ $translate -eq 1 ] && renux_tr "$a"; then
		a=$t
	fi
	args="$args $(quote "$a")"
done

# The buttons' labels, before the script's own, which override them.
labels=
# Yes and No are the same two buttons as OK and Cancel, and Exit is the
# text viewer's; the last label given wins, so each dialog gets its own.
dialog=
for a in "$@"; do
	case "$a" in
	--yesno|--textbox)	dialog=$a ;;
	esac
done
case "$dialog" in
--yesno)
	[ -n "$msg_btn_yes" ] && labels="$labels --yes-label $(quote "$msg_btn_yes")"
	[ -n "$msg_btn_no" ] && labels="$labels --no-label $(quote "$msg_btn_no")"
	;;
--textbox)
	[ -n "$msg_btn_exit" ] && labels="$labels --exit-label $(quote "$msg_btn_exit")"
	;;
*)
	[ -n "$msg_btn_ok" ] && labels="$labels --ok-label $(quote "$msg_btn_ok")"
	[ -n "$msg_btn_cancel" ] && labels="$labels --cancel-label $(quote "$msg_btn_cancel")"
	;;
esac
[ -n "$msg_btn_help" ] && labels="$labels --help-label $(quote "$msg_btn_help")"

theme=
[ -r "$THEME" ] && theme="--load-theme $(quote "$THEME")"

eval "exec \"\$REAL\" $theme $labels $args"
